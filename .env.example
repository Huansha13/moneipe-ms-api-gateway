# api-gateway — plantilla de variables de entorno
# Copia a `.env` y completa. NUNCA subas `.env` a git.

# --- Keycloak (issuer del realm por ambiente, ver Huansha13/moneipe-infra) ---
KEYCLOAK_ISSUER_URI=

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ALLOWED_ORIGINS=

# --- Rutas a los microservicios ---
MS_CONTROL_GASTOS_URI=
MS_INVERSIONES_URI=
MS_NOTIFICACIONES_URI=
MS_USUARIOS_URI=
